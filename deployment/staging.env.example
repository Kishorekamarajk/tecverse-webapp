# Configure these in the staging server's secret/environment settings.
# The known shared staging PostgreSQL database used by the website backend.
DB_URL=jdbc:postgresql://10.184.48.20:5432/tecverse_db
DB_USERNAME=postgres
DB_PASSWORD=NavyExam

# Generate separate random values with at least 32 characters.
MOBILE_TOKEN_SECRET=HgVqJdXhn5i160yLUeTr+PJr+F7Gd62CEyT4lauuq5HoFNqz5GGmqOaLm44S0539

# Browser origin only (no path). Native Android/iOS apps do not use browser CORS.
MOBILE_WEB_ORIGINS=https://tec-verse.cdac.in
MOBILE_SESSION_TTL=PT12H

# Staging and production schemas must be changed by reviewed migrations before
# application deployment. Hibernate validates the schema but does not update it.
JPA_DDL_AUTO=validate

# Read-only admin account; set ADMIN_VIEWER_PASSWORD in the deployment secret store.
ADMIN_VIEWER_USERNAME=tecview@cdac.in
ADMIN_VIEWER_PASSWORD=
# Optional: use a BCrypt hash instead of ADMIN_VIEWER_PASSWORD.
ADMIN_VIEWER_PASSWORD_HASH=

